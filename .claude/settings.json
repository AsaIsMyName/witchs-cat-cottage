{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-before-commit.mjs"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
